# dry-run: reports are only saved to /data/outbox. Nothing is ever sent.
# approve: reports wait for `snitch approve`. Only the digest goes out by itself.
# auto:    reports are sent as soon as they are created.
SNITCH_MODE=dry-run

# Shared with crowdsec/notifications/abuse_webhook.yaml. Generate: openssl rand -hex 32
SNITCH_TOKEN=

# What the report names as the attacked host, usually your server's public IP.
SNITCH_TARGET=

# Never report these networks: your own addresses, office, VPN, monitoring.
SNITCH_ALLOW_CIDRS=

# Text removed from evidence, such as your domains. Comma separated.
SNITCH_REDACT=

# Report only addresses that ip-api.com classifies as hosting and not as mobile
# or proxy. Its free tier is plain HTTP, 45 requests/minute, non-commercial use only.
SNITCH_REQUIRE_HOSTING=true

SNITCH_DEDUPE_DAYS=30
SNITCH_MAX_PER_CONTACT_DAY=3
SNITCH_MAX_PER_DAY=20

# Comma-separated, case-insensitive patterns. Unset uses the built-in safe list.
# SNITCH_SCENARIOS=*cve-[0-9]*,crowdsecurity/http-sensitive-files

# Mail. Not used in dry-run. Pick one provider block.
SNITCH_REPORTER_NAME=Abuse reports
MAIL_FROM=abuse-reports@example.org
MAIL_REPLY_TO=abuse-reports@example.org

# Resend (the sending domain must be verified in Resend)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=resend
SMTP_PASSWORD=

# smtp.bz: copy host, port, login and password from your account dashboard
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USER=
# SMTP_PASSWORD=

# approve mode: where the daily summary of pending reports goes.
SNITCH_OPERATOR_EMAIL=
SNITCH_DIGEST_HOUR_UTC=9
